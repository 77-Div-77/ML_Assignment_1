    "df_v1_pred = pd.DataFrame({'y': v1_test_preds})\n",
    "df_v1_pred.to_csv('IMT2024068_pred_var1.csv', index=False)\n",
    "print(f'Saved Var1 test predictions: {len(df_v1_pred)} rows, no NaNs: {df_v1_pred[\"y\"].notna().all()}')\n",
    "print(f'Prediction range: [{v1_test_preds.min():.2f}, {v1_test_preds.max():.2f}]')\n"
   ]
