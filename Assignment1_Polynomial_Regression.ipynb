    "# Visualize Var2 CV RMSE and R^2 Score vs Polynomial Degree\n",
    "var_y2 = np.var(y_v2)\n",
    "v2_lasso_r2 = 1.0 - (df_v2_sweep['lasso_cv_rmse']**2) / var_y2\n",
    "v2_ridge_r2 = 1.0 - (df_v2_sweep['ridge_cv_rmse']**2) / var_y2\n",
    "v2_ols_r2 = [1.0 - (v**2)/var_y2 if v < 6.0 else np.nan for v in df_v2_sweep['ols_cv_rmse']]\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n",
    "ols_mask2 = df_v2_sweep['ols_cv_rmse'] < 6.0\n",
    "ax1.plot(df_v2_sweep.loc[ols_mask2, 'degree'], df_v2_sweep.loc[ols_mask2, 'ols_cv_rmse'], 's-', color='#e74c3c', label='OLS (Unreg, deg <= 14)')\n",
    "ax1.plot(df_v2_sweep['degree'], df_v2_sweep['ridge_cv_rmse'], '^-', color='#2980b9', label='Ridge (Tuned $\\\lambda_2$)')\n",
    "ax1.plot(df_v2_sweep['degree'], df_v2_sweep['lasso_cv_rmse'], 'o-', color='#27ae60', label='LASSO (Tuned $\\\lambda_1$)')\n",
    "ax1.axvline(x=14, color='#8e44ad', linestyle='--', label='Selected (Degree 14)')\n",
    "ax1.set_xlabel('Polynomial Degree')\n",
    "ax1.set_ylabel('10-Fold CV RMSE')\n",
    "ax1.set_title('Var2: Validation Error vs. Degree')\n",
    "ax1.legend()\n",
    "\n",
    "ols_v2_r2_valid = [(d, r) for d, r in zip(df_v2_sweep['degree'], v2_ols_r2) if not np.isnan(r)]\n",
    "ax2.plot([d for d, r in ols_v2_r2_valid], [r for d, r in ols_v2_r2_valid], 's-', color='#e74c3c', label='OLS (Unreg, deg <= 14)')\n",
    "ax2.plot(df_v2_sweep['degree'], v2_ridge_r2, '^-', color='#2980b9', label='Ridge (Tuned $\\\lambda_2$)')\n",
    "ax2.plot(df_v2_sweep['degree'], v2_lasso_r2, 'o-', color='#27ae60', label='LASSO (Tuned $\\\lambda_1$)')\n",
    "ax2.axvline(x=14, color='#8e44ad', linestyle='--', label='Selected (Degree 14)')\n",
    "ax2.set_xlabel('Polynomial Degree')\n",
    "ax2.set_ylabel('10-Fold CV $R^2$ Score')\n",
    "ax2.set_title('Var2: Cross-Validation $R^2$ Score vs. Degree')\n",
    "ax2.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
